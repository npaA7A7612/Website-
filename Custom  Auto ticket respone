const { Client, GatewayIntentBits } = require('discord.js');

const client = new Client({
intents: [
GatewayIntentBits.Guilds,
GatewayIntentBits.GuildMessages,
GatewayIntentBits.MessageContent
]
});

const TOKEN = "YOUR_BOT_TOKEN";

// Simple AI-like responses
function getAIResponse(message) {
const msg = message.toLowerCase();

if (msg.includes("help")) {
return "👋 Hello! A staff member will assist you shortly. Please describe your issue in detail.";
}

if (msg.includes("buy") || msg.includes("price")) {
return "💰 For pricing, please check our store or wait for staff to assist you!";
}

if (msg.includes("how long") || msg.includes("wait")) {
return "⏳ Response times vary, but staff usually reply within a few minutes.";
}

if (msg.includes("designer")) {
return "🎨 We have many designers available! Please explain what you need.";
}

return "🤖 Thanks for your message! A staff member will respond soon.";
}

client.on("ready", () => {
console.log(`Logged in as ${client.user.tag}`);
});

client.on("messageCreate", async (message) => {
if (message.author.bot) return;

// ONLY respond in ticket channels
if (!message.channel.name.startsWith("ticket-")) return;

// Prevent spam replying to every message instantly
if (!client.cooldowns) client.cooldowns = new Map();

const now = Date.now();
const lastReply = client.cooldowns.get(message.channel.id) || 0;

if (now - lastReply < 5000) return; // 5 sec cooldown

const reply = getAIResponse(message.content);

message.reply(reply);

client.cooldowns.set(message.channel.id, now);
});

client.login(TOKEN);

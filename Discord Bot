client.on('guildMemberAdd', member => {
const now = Date.now();
if (!client.joins) client.joins = [];

```
client.joins.push(now);
client.joins = client.joins.filter(t => now - t < 10000);

if (client.joins.length > 5) {
    member.kick();
    log(member.guild, `Anti-raid kicked ${member.user.tag}`);
}
```

});

// LOGGING EVENTS
client.on('guildMemberRemove', member => {
log(member.guild, `${member.user.tag} left or was kicked.`);
});

client.on('messageDelete', message => {
if (message.author)
log(message.guild, `Message deleted: ${message.content}`);
});

client.login(config.token);

const { Client, GatewayIntentBits, PermissionsBitField, ChannelType } = require('discord.js');
const fs = require('fs');
const config = require('./config.json');

const client = new Client({
intents: [
GatewayIntentBits.Guilds,
GatewayIntentBits.GuildMessages,
GatewayIntentBits.MessageContent,
GatewayIntentBits.GuildMembers
]
});

let infractions = {};
if (fs.existsSync('./infractions.json')) {
infractions = JSON.parse(fs.readFileSync('./infractions.json'));
}

// LOG FUNCTION
function log(guild, message) {
const channel = guild.channels.cache.get(config.logChannel);
if (channel) channel.send(`📜 ${message}`);
}

// READY
client.on('ready', () => {
console.log(`Logged in as ${client.user.tag}`);
});

// MESSAGE COMMANDS
client.on('messageCreate', async message => {
if (!message.content.startsWith(config.prefix) || message.author.bot) return;

```
const args = message.content.slice(config.prefix.length).split(/ +/);
const cmd = args.shift().toLowerCase();

// BAN
if (cmd === 'ban') {
    if (!message.member.permissions.has(PermissionsBitField.Flags.BanMembers)) return;

    const user = message.mentions.members.first();
    if (!user) return message.reply("Mention a user.");

    user.ban();
    message.reply(`Banned ${user.user.tag}`);
    log(message.guild, `${user.user.tag} was banned.`);
}

// TIMEOUT
if (cmd === 'timeout') {
    if (!message.member.permissions.has(PermissionsBitField.Flags.ModerateMembers)) return;

    const user = message.mentions.members.first();
    const time = args[1] * 60000;

    if (!user) return;

    await user.timeout(time);
    message.reply(`Timed out ${user.user.tag}`);
    log(message.guild, `${user.user.tag} timed out.`);
}

// WARN / INFRACTIONS
if (cmd === 'warn') {
    const user = message.mentions.users.first();
    const reason = args.slice(1).join(" ");

    if (!infractions[user.id]) infractions[user.id] = [];
    infractions[user.id].push(reason);

    fs.writeFileSync('./infractions.json', JSON.stringify(infractions, null, 2));

    message.reply(`Warned ${user.tag}`);
    log(message.guild, `${user.tag} warned: ${reason}`);
}

// VIEW INFRACTIONS
if (cmd === 'infractions') {
    const user = message.mentions.users.first();
    const data = infractions[user.id] || [];

    message.reply(`${user.tag} has ${data.length} infractions:\n${data.join("\n")}`);
}

// PROMOTE
if (cmd === 'promote') {
    if (!message.member.roles.cache.has(config.staffRole)) return;

    const user = message.mentions.members.first();
    const role = message.guild.roles.cache.find(r => r.name === args[1]);

    if (!role) return;

    user.roles.add(role);
    message.reply(`${user.user.tag} promoted to ${role.name}`);
    log(message.guild, `${user.user.tag} promoted.`);
}

// TICKET
if (cmd === 'ticket') {
    const channel = await message.guild.channels.create({
        name: `ticket-${message.author.username}`,
        type: ChannelType.GuildText,
        parent: config.ticketCategory,
        permissionOverwrites: [
            {
                id: message.guild.id,
                deny: ['ViewChannel']
            },
            {
                id: message.author.id,
                allow: ['ViewChannel']
            }
        ]
    });

    channel.send(`Support will be with you shortly.`);
    message.reply(`Ticket created: ${channel}`);
}
```

});

